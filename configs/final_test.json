
{
  "experiment": "duplicate_bug_report_final_test",
  "protocol_version": "1.0",
  "split": "test",
  "random_seed": 42,
  "chronological_split": true,
  "candidate_rule": "strictly_earlier_than_query",
  "metric_names": [
    "hit_at_1",
    "hit_at_5",
    "hit_at_10",
    "reciprocal_rank"
  ],
  "bootstrap": {
    "unit": "duplicate_group",
    "resamples": 5000,
    "confidence_level": 0.95
  },
  "embedding": {
    "architecture": "sentence-transformers/all-MiniLM-L6-v2",
    "max_seq_length": 256,
    "normalize_embeddings": true,
    "embedding_dimension": 384
  },
  "fusion": {
    "method": "weighted_rrf",
    "semantic_weight": 0.95,
    "lexical_weight": 0.05,
    "rrf_k": 60
  },
  "entity_reranking": {
    "weight": 0.30,
    "top_k": 50,
    "idf_formula": "log((N+1)/(df+1))+1",
    "idf_fit_scope": "outer_development_only",
    "extractor_version": "existing_frozen_extractor"
  },
  "datasets": {
    "eclipse": {
      "model_name": "eclipse-pilot",
      "model_path": "models/eclipse_minilm_pilot/final",
      "methods": [
        "minilm",
        "hybrid",
        "jaccard_hybrid_w0.3",
        "idf_hybrid_w0.3"
      ],
      "candidate_modes": [
        "unrestricted"
      ]
    },
    "issuedupes": {
      "model_name": "issuedupes-pilot",
      "model_path": "models/issuedupes_minilm_pilot/final",
      "methods": [
        "minilm",
        "hybrid",
        "idf_hybrid_w0.3"
      ],
      "candidate_modes": [
        "unrestricted",
        "same_repository"
      ]
    }
  },
  "output_directory": "results/final_test",
  "allow_test_parameter_tuning": false
}
